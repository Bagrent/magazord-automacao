# Copy to .env and fill in. Never commit .env.
# Base URL: the store's /api root. A trailing /v1 or /v2 is fine too --
# the version is added per endpoint, so it is stripped if you include it.
MAGAZORD_BASE_URL=https://SEU_DOMINIO.painel.magazord.com.br/api
# API credentials, NOT your panel login. If you do not have them, ask
# Magazord (integracao@magazord.com.br) or generate them in the panel.
MAGAZORD_USER=
MAGAZORD_TOKEN=
